# Field Shift · variables de entorno (copiar a .env; .env NUNCA va al repo)
# Todo es opcional: sin credenciales el servidor arranca con el simulador web y adaptadores falsos.

# --- Servidor -------------------------------------------------------------
# Dirección local. En la nube (Render/Fly/Railway) basta con PORT: escucha en 0.0.0.0:$PORT.
ADDR=127.0.0.1:8200
# PORT=8080
# Orígenes que pueden llamar a la API (front estático en Vercel / GitHub Pages). "*" = todos.
CORS_ORIGINS=*
# URL pública del backend (links que manda el bot, imagen de la tarjeta para WhatsApp).
PUBLIC_URL=http://127.0.0.1:8200
# URL pública del front (link "ver tu plan en la web" que manda el bot).
WEB_URL=http://127.0.0.1:8200
# Front desde disco en lugar del embebido (útil en desarrollo): WEB_DIR=web/dist
WEB_DIR=
DATA_DIR=data
STATIC_DIR=web/public/static
FIXTURE_PATH=contracts/fixtures/plan_jocotan.json

# --- Alertas --------------------------------------------------------------
# SQLite (suscriptores, sesiones, alertas, seguimiento). En Render: disco persistente /var/data/fieldshift.db
DB_PATH=fieldshift.db
# Protege /api/admin/* (Authorization: Bearer <token>). Sin token, admin solo desde 127.0.0.1.
ADMIN_TOKEN=
# Scheduler diario de alertas (hora de Guatemala). SCHEDULER=off lo apaga.
SCHEDULER=on
SCHEDULER_HORA=06:00
# Pronóstico (Open-Meteo, sin llave). Solo cambiar si se usa un espejo.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble

# --- Bot ------------------------------------------------------------------
# Nombre con el que se presenta el bot (lo decide el equipo).
BOT_NOMBRE=
# Archivo de sesiones de conversación (por defecto junto a DB_PATH).
BOT_SESIONES=

# --- WhatsApp Cloud API (Meta) · canal principal --------------------------
# developers.facebook.com → tu app → WhatsApp → API Setup (número de prueba)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Lo inventás vos; el mismo valor va en la configuración del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# App Secret (Configuración → Básica). Valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Twilio WhatsApp Sandbox · respaldo para el jurado --------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox, p. ej. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Código "join <palabra-palabra>" que se muestra en la web junto al QR.
TWILIO_SANDBOX_CODE=
# Plantillas aprobadas en Twilio (Content API): TWILIO_CONTENT_<plantilla>=HX...
# TWILIO_CONTENT_ALERTA_CANICULA=

# --- LLM (opcional, apagado por defecto) ----------------------------------
# Solo entiende texto libre y redacta con los números del motor. Ningún número sale del LLM.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Video del sandbox (internal/simvideo; GET /api/sim/video.mp4) ---------
# Base para que el Chromium headless del servidor abra /sandbox?rec=1 (por defecto http://127.0.0.1:$PORT).
SIMVIDEO_BASE_URL=
SIMVIDEO_RUTA=/sandbox
SIMVIDEO_CACHE=
# Videos precalculados (por defecto web/public/static/video)
SIMVIDEO_PRECALC=
# off = solo precalculados (sin Chromium en el servidor)
SIMVIDEO_RENDER=on
CHROME_PATH=
FFMPEG_PATH=
# h264_nvenc (GPU) | libx264 (CPU, nube)
SIMVIDEO_ENCODER=
